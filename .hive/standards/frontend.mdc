## 5. Service Layer

All API calls in `src/services/`. Components never call `axios` directly.

```typescript
// services/projectService.ts
import axios from "axios";
import type { Project, CreateProjectDto } from "../types/domain.types";

const BASE = process.env.REACT_APP_API_URL ?? "http://localhost:3000";

export const projectService = {
    getAll: async (): Promise<Project[]> => {
        const { data } = await axios.get<Project[]>(`${BASE}/projects`);
        return data;
    },

    getById: async (id: string): Promise<Project> => {
        const { data } = await axios.get<Project>(`${BASE}/projects/${id}`);
        return data;
    },

    create: async (dto: CreateProjectDto): Promise<Project> => {
        const { data } = await axios.post<Project>(`${BASE}/projects`, dto);
        return data;
    },

    update: async (id: string, dto: Partial<CreateProjectDto>): Promise<Project> => {
        const { data } = await axios.put<Project>(`${BASE}/projects/${id}`, dto);
        return data;
    },

    remove: async (id: string): Promise<void> => {
        await axios.delete(`${BASE}/projects/${id}`);
    },
};
```

Services throw — callers handle errors. Never swallow in a service.

