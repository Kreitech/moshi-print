generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  slug       String   @unique
  created_at DateTime @default(now()) @db.Timestamptz(6)

  members             TenantMember[]
  customers           Customer[]
  orders              Order[]
  files               File[]
  printers            Printer[]
  materials           Material[]
  print_profiles      PrintProfile[]
  models              Model[]
  model_versions      ModelVersion[]
  order_model_options OrderModelOption[]
  print_jobs          PrintJob[]
  print_attempts      PrintAttempt[]
  sellable_products   SellableProduct[]
  product_variants    ProductVariant[]
  sales_channels      SalesChannel[]
  channel_listings    ChannelListing[]

  @@map("tenants")
}

model TenantMember {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String   @db.Uuid
  user_id    String   @db.Uuid
  role       String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, user_id])
  @@map("tenant_members")
}

model Customer {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String   @db.Uuid
  name       String
  email      String?
  phone      String?
  notes      String?
  created_by String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([tenant_id])
  @@map("customers")
}

model Order {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String   @db.Uuid
  customer_id String?  @db.Uuid
  title       String
  description String?
  quantity    Int      @default(1)
  urgency     String   @default("normal")
  status      String   @default("new")
  tags        String[]
  notes       String?

  // Optional pricing / lightweight revenue tracking — not a payment system.
  // charged_price is what the customer was billed; production cost is separate.
  charged_price_amount   Decimal? @db.Decimal(12, 2)
  charged_price_currency String?  @default("UYU")
  charged_price_notes    String?
  quoted_price_amount    Decimal? @db.Decimal(12, 2)
  quoted_price_currency  String?  @default("UYU")
  payment_status         String   @default("not_tracked")

  created_by String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tenant         Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  customer       Customer?          @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  model_options  OrderModelOption[]
  sourced_models Model[]
  print_jobs     PrintJob[]

  @@index([tenant_id, status])
  @@index([tenant_id, created_at])
  @@map("orders")
}

model File {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String   @db.Uuid
  entity_type String
  entity_id   String   @db.Uuid
  name        String
  file_type   String   @default("other")
  gdrive_url  String?
  notes       String?
  uploaded_by String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, entity_type, entity_id])
  @@map("files")
}

model Printer {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String   @db.Uuid
  name       String
  type       String   @default("FDM")
  model_name String?
  notes      String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  tenant   Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  profiles PrintProfile[]
  attempts PrintAttempt[]

  @@index([tenant_id])
  @@map("printers")
}

model Material {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String   @db.Uuid
  name       String
  brand      String?
  type       String   @default("PLA")
  color      String?
  notes      String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  tenant   Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  profiles PrintProfile[]
  attempts PrintAttempt[]

  @@index([tenant_id])
  @@map("materials")
}

model Model {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id              String   @db.Uuid
  name                   String
  description            String?
  status                 String   @default("idea")
  tags                   String[]
  notes                  String?
  source_url             String?
  source_platform        String?
  license                String?
  commercial_use_allowed Boolean?
  attribution_required   Boolean?
  attribution_text       String?
  license_notes          String?
  source_order_id        String?  @db.Uuid
  created_by             String   @db.Uuid
  created_at             DateTime @default(now()) @db.Timestamptz(6)
  updated_at             DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tenant            Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  source_order      Order?             @relation(fields: [source_order_id], references: [id], onDelete: SetNull)
  versions          ModelVersion[]
  options           OrderModelOption[]
  sellable_products SellableProduct[]

  @@index([tenant_id, status])
  @@index([tenant_id])
  @@map("models")
}

model ModelVersion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String   @db.Uuid
  model_id       String   @db.Uuid
  version_number Int
  notes          String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  model      Model      @relation(fields: [model_id], references: [id], onDelete: Cascade)
  print_jobs PrintJob[]

  @@unique([model_id, version_number])
  @@index([model_id])
  @@map("model_versions")
}

model OrderModelOption {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String   @db.Uuid
  order_id    String   @db.Uuid
  model_id    String?  @db.Uuid
  title       String
  source_url  String?
  notes       String?
  is_selected Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [order_id], references: [id], onDelete: Cascade)
  model  Model? @relation(fields: [model_id], references: [id], onDelete: SetNull)

  @@index([order_id])
  @@index([model_id])
  @@map("order_model_options")
}

model PrintProfile {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id              String   @db.Uuid
  name                   String
  printer_id             String   @db.Uuid
  material_id            String   @db.Uuid
  notes                  String?
  is_active              Boolean  @default(true)
  layer_height_mm        Decimal? @db.Decimal(4, 2)
  nozzle_temp            Int?
  bed_temp               Int?
  print_speed_mm_s       Int?
  wall_count             Int?
  infill_pct             Int?
  supports               Boolean?
  brim_raft_skirt        String?
  exposure_time_s        Decimal? @db.Decimal(6, 2)
  bottom_exposure_time_s Decimal? @db.Decimal(6, 2)
  lift_speed_mm_s        Decimal? @db.Decimal(6, 2)
  resin_layer_height_mm  Decimal? @db.Decimal(4, 2)
  supports_notes         String?
  created_at             DateTime @default(now()) @db.Timestamptz(6)

  tenant         Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  printer        Printer        @relation(fields: [printer_id], references: [id])
  material       Material       @relation(fields: [material_id], references: [id])
  attempts_used  PrintAttempt[] @relation("AttemptProfile")
  attempts_saved PrintAttempt[] @relation("AttemptSavedProfile")

  @@index([tenant_id])
  @@map("print_profiles")
}

model PrintJob {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String   @db.Uuid
  order_id           String   @db.Uuid
  model_version_id   String?  @db.Uuid
  status             String   @default("pending")
  quantity_planned   Int
  quantity_completed Int      @default(0)
  quantity_failed    Int      @default(0)
  notes              String?
  created_by         String   @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  order         Order          @relation(fields: [order_id], references: [id], onDelete: Cascade)
  model_version ModelVersion?  @relation(fields: [model_version_id], references: [id], onDelete: SetNull)
  attempts      PrintAttempt[]

  @@index([tenant_id, order_id])
  @@index([tenant_id])
  @@map("print_jobs")
}

model PrintAttempt {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String   @db.Uuid
  print_job_id        String   @db.Uuid
  printer_id          String   @db.Uuid
  material_id         String   @db.Uuid
  print_profile_id    String?  @db.Uuid
  result              String
  duration_min        Int?
  notes               String?
  failure_reason      String?
  saved_as_profile_id String?  @db.Uuid
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  tenant           Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  print_job        PrintJob      @relation(fields: [print_job_id], references: [id], onDelete: Cascade)
  printer          Printer       @relation(fields: [printer_id], references: [id])
  material         Material      @relation(fields: [material_id], references: [id])
  print_profile    PrintProfile? @relation("AttemptProfile", fields: [print_profile_id], references: [id], onDelete: SetNull)
  saved_as_profile PrintProfile? @relation("AttemptSavedProfile", fields: [saved_as_profile_id], references: [id], onDelete: SetNull)

  @@index([print_job_id])
  @@index([tenant_id])
  @@map("print_attempts")
}

model SellableProduct {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                   String   @db.Uuid
  model_id                    String?  @db.Uuid
  name                        String
  description                 String?
  base_price_amount           Decimal? @db.Decimal(12, 2)
  base_price_currency         String?  @default("UYU")
  production_cost_amount      Decimal? @db.Decimal(12, 2)
  production_cost_currency    String?  @default("UYU")
  estimated_margin_amount     Decimal? @db.Decimal(12, 2)
  estimated_margin_percentage Decimal? @db.Decimal(5, 2)
  lead_time_days              Int?
  status                      String   @default("draft")
  stock_mode                  String   @default("made_to_order")
  available_quantity          Int?
  commercial_use_allowed      Boolean?
  attribution_required        Boolean?
  license_notes               String?
  notes                       String?
  created_at                  DateTime @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tenant   Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  model    Model?           @relation(fields: [model_id], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  listings ChannelListing[]

  @@index([tenant_id, status])
  @@index([tenant_id])
  @@index([model_id])
  @@map("sellable_products")
}

model ProductVariant {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id            String   @db.Uuid
  product_id           String   @db.Uuid
  sku                  String?
  color                String?
  size                 String?
  material             String?
  price_delta_amount   Decimal? @db.Decimal(12, 2)
  price_delta_currency String?  @default("UYU")
  notes                String?
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tenant  Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  product SellableProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@index([tenant_id])
  @@map("product_variants")
}

model SalesChannel {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String   @db.Uuid
  provider            String
  status              String   @default("manual_only")
  display_name        String
  connection_metadata Json?
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tenant   Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  listings ChannelListing[]

  @@index([tenant_id])
  @@map("sales_channels")
}

model ChannelListing {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String    @db.Uuid
  product_id          String    @db.Uuid
  sales_channel_id    String?   @db.Uuid
  provider            String
  external_listing_id String?
  external_url        String?
  status              String    @default("draft")
  title               String
  description         String
  price_amount        Decimal?  @db.Decimal(12, 2)
  price_currency      String?   @default("UYU")
  suggested_tags      Json?
  photo_checklist     Json?
  publish_payload     Json?
  error_message       String?
  last_synced_at      DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  tenant        Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  product       SellableProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)
  sales_channel SalesChannel?   @relation(fields: [sales_channel_id], references: [id], onDelete: SetNull)

  @@index([product_id])
  @@index([tenant_id])
  @@map("channel_listings")
}
