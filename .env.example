# App — required for auth email redirect links (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — required
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database — required for Prisma migrations
# Use the "Transaction mode" pooler URL from Supabase → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.your-project-id:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Use the direct connection URL for migrations (Settings → Database → URI, port 5432)
DIRECT_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# Seed script — set to your Supabase user ID to seed Moshicrea tenant
SEED_OWNER_USER_ID=

# Google Drive — post-MVP (leave empty for now)
# GOOGLE_SERVICE_ACCOUNT_JSON=
