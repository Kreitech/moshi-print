# Standards: Backend (node-react-prisma stack)
> Extends `core/standards/core.mdc`. Read core first.
> Stack: Node.js · TypeScript strict · Express · Prisma · PostgreSQL · Jest

---

## 1. Project Structure

```
src/backend/src/
├── domain/
│   ├── models/          # Entities, Value Objects, Aggregates
│   └── repositories/    # Repository interfaces (IEmployeeRepository, etc.)
├── application/
│   ├── services/        # Business logic orchestration
│   └── validator.ts     # Centralized input validation
├── presentation/
│   └── controllers/     # Thin HTTP handlers — delegate to services
├── infrastructure/
│   ├── logger.ts        # Structured logger (never console.log)
│   └── prismaClient.ts  # Prisma singleton
├── routes/              # Express route definitions
├── middleware/          # Auth, error handler, rate limiter
├── index.ts             # App entry point (Express)
└── lambda.ts            # AWS Lambda handler (serverless-http wrapper)
```

---

## 2. DDD Layer Rules

### Layer responsibilities (never cross these boundaries)

| Layer | Allowed | Forbidden |
|---|---|---|
| **Domain** | Entities, Value Objects, domain logic, repository *interfaces* | Prisma imports, Express imports, any I/O |
| **Application** | Orchestrate domain objects, call repositories, validate inputs | Business logic (belongs in domain), direct Prisma calls |
| **Infrastructure** | Prisma queries, external API clients, logger setup | Business logic, HTTP concerns |
| **Presentation** | Parse HTTP request, call application service, format response | Business logic, direct Prisma, domain logic |

### Domain Entity pattern

Domain entities contain business logic only — **no Prisma imports, no I/O**.
Persistence is handled by repository implementations in the infrastructure layer.

```typescript
// domain/models/Employee.ts — NO Prisma imports here
type EmployeeProps = {
    id?: number;
    firstName: string;
    lastName: string;
    email: string;
    departments: Department[];
};

export class Employee {
    constructor(private readonly props: EmployeeProps) {}

    get id(): number | undefined { return this.props.id; }
    get firstName(): string { return this.props.firstName; }
    get lastName(): string { return this.props.lastName; }
    get email(): string { return this.props.email; }
    get departments(): Department[] { return [...this.props.departments]; }

    changeEmail(newEmail: string): void {
        if (!EmailVO.isValid(newEmail)) throw new ValidationError('Invalid email');
        this.props.email = newEmail;
    }

    addDepartment(department: Department): void {
        if (this.props.departments.some(d => d.id === department.id)) {
            throw new ConflictError('Employee already in this department');
        }
        this.props.departments.push(department);
    }
}
```

### Infrastructure repository pattern (implements domain interface)

```typescript
// infrastructure/repositories/PrismaEmployeeRepository.ts
import { prisma } from '../prismaClient';
import type { IEmployeeRepository } from '../../domain/repositories/IEmployeeRepository';
import { EmployeeMapper } from '../mappers/EmployeeMapper';

export class PrismaEmployeeRepository implements IEmployeeRepository {
    async findById(id: number): Promise<Employee | null> {
        const data = await prisma.employee.findUnique({
            where: { id },
            include: { departments: true }
        });
        return data ? EmployeeMapper.toDomain(data) : null;
    }

    async findByEmail(email: string): Promise<Employee | null> {
        const data = await prisma.employee.findUnique({
            where: { email },
            include: { departments: true }
        });
        return data ? EmployeeMapper.toDomain(data) : null;
    }

    async save(employee: Employee): Promise<Employee> {
        const data = EmployeeMapper.toPrisma(employee);
        const saved = employee.id
            ? await prisma.employee.update({ where: { id: employee.id }, data })
            : await prisma.employee.create({ data });
        return EmployeeMapper.toDomain(saved);
    }

    async list(filter: EmployeeFilter): Promise<[Employee[], number]> {
        const [records, total] = await Promise.all([
            prisma.employee.findMany({ where: filter.toWhere(), skip: filter.offset, take: filter.limit, include: { departments: true } }),
            prisma.employee.count({ where: filter.toWhere() }),
        ]);
        return [records.map(EmployeeMapper.toDomain), total];
    }
}
```

### Repository interface pattern (domain layer)

```typescript
// domain/repositories/IEmployeeRepository.ts
export interface IEmployeeRepository {
    findById(id: number): Promise<Employee | null>;
    findByEmail(email: string): Promise<Employee | null>;
    save(employee: Employee): Promise<Employee>;
    list(filter: EmployeeFilter): Promise<[Employee[], number]>;
}
```

### Application service pattern

Services receive repositories via constructor injection — never import Prisma directly.

```typescript
// application/services/EmployeeService.ts
export class EmployeeService {
    constructor(private readonly employeeRepo: IEmployeeRepository) {}

    async create(data: CreateEmployeeInput): Promise<Employee> {
        // 1. Validate input
        const validated = validateEmployeeData(data);

        // 2. Check business rules via repository
        const existing = await this.employeeRepo.findByEmail(validated.email);
        if (existing) throw new ConflictError('Email already registered');

        // 3. Create domain entity and persist via repository
        const employee = new Employee(validated);
        return this.employeeRepo.save(employee);
    }
}
```

### Controller pattern (thin — no logic)

```typescript
// presentation/controllers/employeeController.ts
export class EmployeeController {
    constructor(private readonly employeeService: EmployeeService) {}

    create = async (req: Request, res: Response, next: NextFunction): Promise<void> => {
        try {
            const employee = await this.employeeService.create(req.body);
            res.status(201).json({ success: true, data: employee });
        } catch (error) {
            next(error);
        }
    };
}
```

